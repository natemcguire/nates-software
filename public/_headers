# Cloudflare Pages headers — fix stale-index / broken-asset MIME errors.
# Content-hashed assets are immutable and cache forever; the HTML shell must
# never be cached, so a redeploy's new asset hashes are always picked up.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# The lineage share card (/tree/:app.svg) is a Pages Function returning SVG. Pages can
# stamp text/html on function routes it treats as HTML — which breaks it as an og:image.
# A _headers rule forces the correct image content-type for the .svg card path.
/tree/*.svg
  Content-Type: image/svg+xml; charset=utf-8
  Cache-Control: public, max-age=60, s-maxage=300

# The plain-words explainer. Served as text/markdown it triggers a DOWNLOAD in browsers
# (the most-clicked "what is this" link on a source-reader launch). Force text/plain so it
# renders inline. (nosniff is intentionally absent so the browser displays it as text.)
/vision.md
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
